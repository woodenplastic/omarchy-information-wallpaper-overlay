#!/usr/bin/python3
"""Tray icon for Information Wallpaper Overlay: a StatusNotifierItem whose click opens the
settings, so the icon can sit behind the tray's arrow. Started by the widget
while "Show in the tray" is on, and uses the system Python's PyGObject, which
Omarchy ships.

The widget sends lines on stdin:
  icon <state> <mark #rrggbb> <dot #rrggbb>   state: none|success|failure|running
  tooltip <text>
The icon is drawn as an SVG in those colors, the tiles mark in the bar's
text color and the CI state as a dot, since the tray would tint a symbolic
icon in one color. The helper exits when stdin closes, with the shell."""

import os
import re
import subprocess
import sys

import gi
from gi.repository import Gio, GLib

# Newer GLib moved the Unix streams to GioUnix; older ones keep them in Gio.
try:
    gi.require_version("GioUnix", "2.0")
    from gi.repository import GioUnix
    UnixInputStream = GioUnix.InputStream
except (ValueError, ImportError):
    UnixInputStream = Gio.UnixInputStream

PLUGIN_ID = "woodenplastic.information-wallpaper-overlay"
# One tray icon, even with a bar (and so a widget) on every monitor.
UNIQUE_NAME = "io.github.woodenplastic.InformationWallpaperOverlay"
ITEM_PATH = "/StatusNotifierItem"
ICON_DIR = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "information-wallpaper-overlay-icons")

# Four tiles, two by two, with rounded corners.
def _tile(x, y, s=7, r=1.5):
    return ("M%g %gh%ga%g %g 0 0 1 %g %gv%ga%g %g 0 0 1 %g %gh%ga%g %g 0 0 1 %g %gv%ga%g %g 0 0 1 %g %gZ"
            % (x + r, y, s - 2 * r, r, r, r, r, s - 2 * r, r, r, -r, r, -(s - 2 * r), r, r, -r, -r, -(s - 2 * r), r, r, r, -r))


MARK = "".join(_tile(x, y) for x, y in ((0, 0), (9, 0), (0, 9), (9, 9)))

INTERFACE = """
<node>
  <interface name="org.kde.StatusNotifierItem">
    <property name="Category" type="s" access="read"/>
    <property name="Id" type="s" access="read"/>
    <property name="Title" type="s" access="read"/>
    <property name="Status" type="s" access="read"/>
    <property name="IconName" type="s" access="read"/>
    <property name="IconThemePath" type="s" access="read"/>
    <property name="ItemIsMenu" type="b" access="read"/>
    <property name="ToolTip" type="(sa(iiay)ss)" access="read"/>
    <method name="Activate"><arg name="x" type="i" direction="in"/><arg name="y" type="i" direction="in"/></method>
    <method name="SecondaryActivate"><arg name="x" type="i" direction="in"/><arg name="y" type="i" direction="in"/></method>
    <method name="ContextMenu"><arg name="x" type="i" direction="in"/><arg name="y" type="i" direction="in"/></method>
    <method name="Scroll"><arg name="delta" type="i" direction="in"/><arg name="orientation" type="s" direction="in"/></method>
    <signal name="NewIcon"/>
    <signal name="NewToolTip"/>
    <signal name="NewStatus"><arg name="status" type="s"/></signal>
  </interface>
</node>
"""

state = {"icon": "", "tooltip": "Information Wallpaper Overlay"}
HEX = re.compile(r"^#[0-9a-fA-F]{6}$")


def draw_icon(ci, mark, dot):
    """Writes the icon for this state and colors and returns its name. Each
    combination gets its own name, so the tray loads it afresh."""
    if not HEX.match(mark):
        mark = "#ffffff"
    if not HEX.match(dot):
        dot = mark
    name = "info-overlay-%s-%s-%s" % (ci, mark[1:].lower(), dot[1:].lower())
    path = os.path.join(ICON_DIR, name + ".svg")
    if not os.path.exists(path):
        os.makedirs(ICON_DIR, exist_ok=True)
        if ci == "none":
            body = '<path fill="%s" d="%s"/>' % (mark, MARK)
        else:
            # The mark with a notch cut where the dot sits, then the dot.
            body = ('<mask id="m"><rect width="16" height="16" fill="#fff"/>'
                    '<circle cx="12.6" cy="12.6" r="4.4" fill="#000"/></mask>'
                    '<path fill="%s" d="%s" mask="url(#m)"/>'
                    '<circle cx="12.6" cy="12.6" r="3.1" fill="%s"/>') % (mark, MARK, dot)
        tmp = path + ".tmp"
        with open(tmp, "w") as f:
            f.write('<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16">%s</svg>' % body)
        os.replace(tmp, path)
    return name


def properties():
    return {
        "Category": GLib.Variant("s", "ApplicationStatus"),
        "Id": GLib.Variant("s", PLUGIN_ID),
        "Title": GLib.Variant("s", "Information Wallpaper Overlay"),
        "Status": GLib.Variant("s", "Active"),
        "IconName": GLib.Variant("s", state["icon"] or draw_icon("none", "#ffffff", "")),
        "IconThemePath": GLib.Variant("s", ICON_DIR),
        "ItemIsMenu": GLib.Variant("b", False),
        "ToolTip": GLib.Variant("(sa(iiay)ss)", ("", [], "Information Wallpaper Overlay", state["tooltip"])),
    }


def toggle_settings():
    # The tray does not pass the click position, but the cursor is on the icon,
    # so open the popup there.
    try:
        pos = subprocess.run(["hyprctl", "cursorpos"], capture_output=True, text=True, timeout=2).stdout
        x, y = (str(int(float(v))) for v in pos.split(","))
        command = ["omarchy-shell", PLUGIN_ID, "toggleAt", x, y]
    except (OSError, ValueError, subprocess.SubprocessError):
        command = ["omarchy-shell", PLUGIN_ID, "toggle"]
    subprocess.Popen(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def on_method_call(_conn, _sender, _path, _iface, method, _params, invocation):
    if method in ("Activate", "SecondaryActivate", "ContextMenu"):
        toggle_settings()
    invocation.return_value(None)


def on_get_property(_conn, _sender, _path, _iface, name):
    return properties().get(name)


def main():
    loop = GLib.MainLoop()
    bus = Gio.bus_get_sync(Gio.BusType.SESSION)

    reply = bus.call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
                          "RequestName", GLib.Variant("(su)", (UNIQUE_NAME, 4)),  # DO_NOT_QUEUE
                          GLib.VariantType("(u)"), Gio.DBusCallFlags.NONE, -1, None)
    if reply.unpack()[0] not in (1, 4):  # neither primary owner nor already owner
        return 0

    node = Gio.DBusNodeInfo.new_for_xml(INTERFACE)
    bus.register_object_with_closures2(ITEM_PATH, node.interfaces[0], on_method_call, on_get_property, None)

    def emit(signal):
        bus.emit_signal(None, ITEM_PATH, "org.kde.StatusNotifierItem", signal, None)

    def register(*_args):
        bus.call("org.kde.StatusNotifierWatcher", "/StatusNotifierWatcher", "org.kde.StatusNotifierWatcher",
                 "RegisterStatusNotifierItem", GLib.Variant("(s)", (bus.get_unique_name(),)),
                 None, Gio.DBusCallFlags.NONE, -1, None, None)

    # Register now and again whenever the tray host (re)starts.
    Gio.bus_watch_name_on_connection(bus, "org.kde.StatusNotifierWatcher", Gio.BusNameWatcherFlags.NONE,
                                     register, None)

    def on_line(stream, result):
        line, _length = stream.read_line_finish_utf8(result)
        if line is None:  # stdin closed: the widget or the shell is gone
            loop.quit()
            return
        parts = line.strip().split(" ", 1)
        if parts[0] == "icon" and len(parts) == 2:
            args = parts[1].split()
            if len(args) == 3:
                name = draw_icon(args[0] if args[0] in ("none", "success", "failure", "running") else "none",
                                 args[1], args[2])
                if name != state["icon"]:
                    state["icon"] = name
                    emit("NewIcon")
        elif parts[0] == "tooltip":
            state["tooltip"] = parts[1] if len(parts) == 2 else ""
            emit("NewToolTip")
        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, on_line)

    stdin = Gio.DataInputStream.new(UnixInputStream.new(sys.stdin.fileno(), False))
    stdin.read_line_async(GLib.PRIORITY_DEFAULT, None, on_line)

    loop.run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
