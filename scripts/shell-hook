#!/bin/bash

# Puts the shell hook (shell-hook.bash) in ~/.bashrc, or takes it out, so
# tasks started in a terminal show whether they passed.
#
#   shell-hook status   on or off
#   shell-hook on       adds the line to ~/.bashrc; new terminals have it
#   shell-hook off      removes it

set -uo pipefail

RC="$HOME/.bashrc"
MARK="# information-wallpaper-overlay: exit status of long commands"
HOOK="$(cd "$(dirname "$0")" && pwd)/shell-hook.bash"
# Through ~, so the line keeps working for the same user and plugin folder.
LINE="[[ -r ${HOOK/#$HOME/\~} ]] && source ${HOOK/#$HOME/\~} $MARK"

case "${1:-}" in
status)
  grep -qF "$MARK" "$RC" 2>/dev/null && echo on || echo off
  ;;
on)
  grep -qF "$MARK" "$RC" 2>/dev/null && exit 0
  printf '\n%s\n' "$LINE" >>"$RC"
  ;;
off)
  grep -qF "$MARK" "$RC" 2>/dev/null || exit 0
  # The file itself, so a linked ~/.bashrc stays a link to it.
  target=$(readlink -f -- "$RC") || exit 1
  [[ -f $target ]] || exit 1
  # Written beside it in full, then renamed over it in one step: until then
  # the old file is untouched, and anything failing leaves it as it was.
  tmp=$(mktemp "$target.XXXXXX") || exit 1
  trap 'rm -f -- "$tmp"' EXIT
  grep -vF "$MARK" -- "$target" >"$tmp"
  (($? <= 1)) || exit 1
  chmod --reference="$target" -- "$tmp" || exit 1
  sync -- "$tmp" || exit 1
  mv -f -- "$tmp" "$target" || exit 1
  trap - EXIT
  ;;
*)
  echo "usage: shell-hook status|on|off" >&2
  exit 1
  ;;
esac
