#!/usr/bin/python3
"""Watches for long tasks for the tasks tile: builds, flashing, updates,
copies. Every two seconds it looks through /proc for known tools, and prints
one JSON line on stdout:

  {"tasks": [{"id", "label", "folder", "by", "state", "elapsed", "ago",
              "cpu", "jobs", "step", "expected", "load", "pane", "progress",
              "rate"}]}

A task is the topmost matching process; what runs under it (compilers,
linkers) counts as its jobs, and the newest of them that's busy says what
it's doing: "compiling main.c", "building serde", "linking app.elf". It shows
once it's run five seconds. expected is how long the same task in the same
folder took the last times (the median of three; 0 when it hasn't run
before), kept in $XDG_STATE_HOME/information-wallpaper-overlay/durations.json.
load is its CPU over the last two minutes, one value per tick, as a share of
the whole machine (0-100). pane is the herdr pane it runs in
($HERDR_PANE_ID), "" outside herdr. A copy that reads one file start to end
(dd, zstd, xz, ffmpeg, tar or 7z extracting) has progress, how far into
that file it is (0-1), and rate, how fast it reads (bytes/s); for anything
else progress is -1. The last
tasks that ended stay in the list, and are kept in
$XDG_STATE_HOME/information-wallpaper-overlay/tasks.json across restarts. Whether it passed comes from the shell hook
(scripts/shell-hook.bash), which notes the exit status of terminal commands;
without a record the task is just "done". state: running, success, failure,
cancelled or done.

  tasks [extra-tool ...]

Extra tools match by their program name. The watcher exits when stdin
closes, with the shell."""

import json
import os
import re
import select
import stat
import sys
import time

TICK = 2.0
MIN_AGE = 5
HISTORY_S = 30 * 60
HISTORY_MAX = 20
# How long after a task ends its exit status can still arrive.
STATUS_WAIT_S = 30

RUNTIME = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "information-wallpaper-overlay")
COMMANDS = os.path.join(RUNTIME, "commands.jsonl")
STATE = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "information-wallpaper-overlay")
HISTORY = os.path.join(STATE, "tasks.json")
KEPT = ("id", "label", "folder", "by", "started", "ended", "state")
DURATIONS = os.path.join(STATE, "durations.json")
DURATIONS_KEEP = 5
DURATIONS_MAX = 200
LOAD_KEEP = 60

CLK = os.sysconf("SC_CLK_TCK")
NCPU = os.cpu_count() or 1
INTERPRETERS = {"python", "python3", "node", "bun", "deno", "sh", "bash", "perl", "ruby"}
AGENTS = {"claude", "codex", "opencode", "copilot", "gemini", "cursor-agent", "aider", "crush", "pi", "goose", "amp"}
# Arguments that mean a program keeps running on purpose, not a task.
ONGOING = {"dev", "serve", "watch", "monitor", "start", "preview", "run-dev", "menuconfig", "repl", "shell"}


def base(path):
    return os.path.basename(path or "")


def positional(args):
    return [a for a in args if a and not a.startswith("-") and "/" not in a and "=" not in a and a.strip(".")]


# tool -> the subcommands that make it a task (None: any), and whether the
# first one goes in the label. Paths and file names never do.
RULES = {
    "idf.py": (None, True), "esptool": (None, True), "esptool.py": (None, True),
    "make": (None, False), "ninja": (None, False), "cmake": ("--build", False), "meson": ({"compile", "setup"}, True),
    "cargo": ({"build", "b", "test", "t", "check", "c", "clippy", "install", "doc", "bench", "tauri"}, True),
    "gradle": (None, True), "gradlew": (None, True), "mvn": (None, True),
    "go": ({"build", "test", "install", "generate"}, True),
    "npm": ({"run", "install", "i", "ci", "test", "exec"}, True), "pnpm": (None, True), "yarn": (None, True), "bun": ({"run", "install", "i", "test", "build"}, True),
    "tsc": (None, False), "vite": ({"build"}, True), "webpack": (None, False), "next": ({"build"}, True),
    "docker": ({"build", "pull", "push", "buildx", "compose"}, True), "podman": ({"build", "pull", "push"}, True),
    "pacman": ("-S -U -R", False), "yay": (None, False), "paru": (None, False), "makepkg": (None, False),
    "flatpak": ({"install", "update", "upgrade", "uninstall"}, True),
    "pip": ({"install"}, True), "uv": ({"sync", "pip", "tool"}, True),
    "pytest": (None, False), "kicad-cli": (None, True), "freerouting": (None, False),
    "pio": ({"run"}, True), "platformio": ({"run"}, True), "arduino-cli": ({"compile", "upload"}, True), "dfu-util": (None, False),
    "rsync": (None, False), "dd": (None, False), "ffmpeg": (None, False), "tar": (None, False), "zstd": (None, False), "xz": (None, False), "7z": (None, False),
    "git": ({"clone", "fetch", "pull", "push", "gc", "lfs"}, True),
}


def program(argv):
    """The program a command line runs and its arguments: for an
    interpreter, the script or module it runs. (None, []) when there's none."""
    if not argv:
        return None, []
    tool, args = base(argv[0]), argv[1:]
    if tool.startswith("python") and len(args) >= 2 and args[0] == "-m":
        return args[1], args[2:]
    if tool in INTERPRETERS or tool.startswith("python"):
        scripts = [a for a in args if not a.startswith("-")]
        if not scripts:
            return None, []
        i = args.index(scripts[0])
        return base(scripts[0]), args[i + 1:]
    return tool, args


def match(argv, extra):
    """The label of a task for a command line, or None."""
    tool, args = program(argv)
    if not tool:
        return None
    tool = re.sub(r"\.js$|-cli\.js$", "", tool)
    if tool == "npm-cli":
        tool = "npm"
    words = positional(args)
    if ONGOING.intersection(w.lower() for w in words):
        return None
    if tool in extra:
        return " ".join([tool] + words[:1])
    rule = RULES.get(tool)
    if rule is None:
        return None
    subs, labelled = rule
    if tool == "cmake":
        return "cmake --build" if "--build" in args else None
    if tool == "pacman":
        ops = [a for a in args if re.match(r"^-[A-Za-z]*[SUR]", a) and not a.startswith("--")]
        return "pacman " + ops[0] if ops and not re.match(r"^-[A-Za-z]*[Qs]", ops[0]) else None
    if tool in ("yay", "paru") and any(a.startswith("-Q") or a.startswith("-G") for a in args):
        return None
    if subs is not None and not (words and words[0] in subs):
        return None
    if tool in ("npm", "pnpm", "yarn", "bun") and words[:1] == ["run"]:
        words = words[1:]
    # Two words where the second says what: "idf.py build flash",
    # "npm tauri build", "docker compose build".
    two = tool in ("idf.py", "npm", "pnpm", "yarn", "bun", "docker")
    return " ".join([tool] + (words[:2] if two else words[:1] if labelled else []))


COMPILER = re.compile(r"(^|-)(gcc|g\+\+|c\+\+|cc|clang|clang\+\+)(-[\d.]+)?$")
LINKER = re.compile(r"(^|-)(ld(\.\w+)?|lld|mold|collect2)$")
SOURCE = re.compile(r"\.(c|cc|cpp|cxx|c\+\+|m|mm|s|sx|asm|f|f90|cu)$", re.I)
# Cargo's and rustc's file names end in a hash: "serde-3f1a09c2b7d4e865".
HASH = re.compile(r"-[0-9a-f]{16}$")
ESPTOOL_STEPS = {"write_flash": "writing flash", "erase_flash": "erasing flash", "read_flash": "reading flash", "verify_flash": "verifying flash"}
GIT_STEPS = {"index-pack": "indexing objects", "pack-objects": "packing objects", "unpack-objects": "unpacking objects",
             "remote-https": "transferring", "remote-http": "transferring", "upload-pack": "sending objects"}
# Programs that only pass the work on; they never say what's being done.
PASSING = INTERPRETERS | {"env", "sudo", "doas", "xargs", "time", "nice", "ionice", "timeout", "stdbuf", "zsh", "dash", "fish"}


def after(args, flag):
    i = args.index(flag) if flag in args else -1
    return args[i + 1] if 0 <= i < len(args) - 1 else ""


def output_of(args):
    out = after(args, "-o") or next((a[2:] for a in args if a.startswith("-o") and len(a) > 2), "")
    return HASH.sub("", base(out))


def source_of(args):
    return next((base(a) for i, a in enumerate(args) if SOURCE.search(a) and (i == 0 or args[i - 1] != "-o")), "")


def describe(argv):
    """What a process under a task is doing, for the programs that tell:
    "compiling main.c", "linking app.elf", "building serde". None for the
    rest."""
    tool, args = program(argv)
    if not tool:
        return None
    if tool in ("cc1", "cc1plus", "cc1obj"):
        src = base(after(args, "-dumpbase")) or source_of(args)
        return "compiling " + src if src else "compiling"
    if COMPILER.search(tool):
        if args[:1] == ["-cc1"]:
            src = base(after(args, "-main-file-name")) or source_of(args)
            return "compiling " + src if src else "compiling"
        if "-E" in args:
            return None
        if "-c" in args or "-S" in args:
            src = source_of(args)
            return "compiling " + src if src else "compiling"
        out = output_of(args)
        return "linking " + out if out else None
    if LINKER.search(tool):
        out = output_of(args)
        return "linking " + out if out else "linking"
    if tool == "rustc":
        crate = after(args, "--crate-name")
        if not crate:
            return None
        return "running a build script" if crate == "build_script_build" else "building " + crate
    if tool in ("esptool", "esptool.py"):
        # Options come with values ("--chip esp32"); the command is a word
        # it knows.
        return next((ESPTOOL_STEPS[w.replace("-", "_")] for w in positional(args) if w.replace("-", "_") in ESPTOOL_STEPS), None)
    if tool.startswith("git-") and tool[4:] in GIT_STEPS:
        return GIT_STEPS[tool[4:]]
    if tool == "git":
        words = positional(args)
        return GIT_STEPS.get(words[0]) if words else None
    return None


def step_of(tree, procs, busy, labels):
    """What a task is doing: the newest busy process under it that tells,
    or else the newest busy program under it by name."""
    generic = None
    for q in sorted(tree[1:], key=lambda q: -procs[q]["start"]):
        if q not in busy:
            continue
        said = describe(procs[q]["argv"])
        if said:
            return said
        if generic is None and q not in labels:
            tool, _ = program(procs[q]["argv"])
            if tool and tool not in PASSING and not COMPILER.search(tool):
                generic = tool
    return generic


BOOT = 0.0
with open("/proc/stat") as f:
    for line in f:
        if line.startswith("btime "):
            BOOT = float(line.split()[1])

# pid -> ((starttime, name), argv); each command line is read once. The name
# changes with exec and a new title, which keep the start time.
argv_cache = {}


def scan():
    """pid -> {ppid, start (epoch), own, total, argv} for every process: own
    is its CPU ticks, total adds its children's that ended."""
    procs = {}
    for name in os.listdir("/proc"):
        if not name.isdigit():
            continue
        pid = int(name)
        try:
            with open("/proc/%d/stat" % pid) as f:
                stat = f.read()
        except OSError:
            continue
        comm = stat[stat.find("(") + 1:stat.rfind(")")]
        rest = stat[stat.rfind(")") + 2:].split()
        ppid, own, start = int(rest[1]), int(rest[11]) + int(rest[12]), int(rest[19])
        # With the time of its children that ended: a build's compilers
        # mostly start and end between two looks.
        total = own + int(rest[13]) + int(rest[14])
        cached = argv_cache.get(pid)
        if cached and cached[0] == (start, comm):
            argv = cached[1]
        else:
            try:
                with open("/proc/%d/cmdline" % pid, "rb") as f:
                    argv = [a.decode(errors="replace") for a in f.read().split(b"\0") if a]
            except OSError:
                argv = []
            # Programs that set their title (npm, node) leave one string with
            # spaces in it: "npm run tauri build".
            if len(argv) == 1 and " " in argv[0]:
                argv = argv[0].split()
            argv_cache[pid] = ((start, comm), argv)
        procs[pid] = {"ppid": ppid, "start": BOOT + start / CLK, "own": own, "total": total, "argv": argv}
    for pid in list(argv_cache):
        if pid not in procs:
            del argv_cache[pid]
    return procs


def ancestors(pid, procs):
    out = []
    p = procs.get(pid)
    while p and p["ppid"] > 1 and len(out) < 12:
        out.append(p["ppid"])
        p = procs.get(p["ppid"])
    return out


def pane_of(pid, up):
    """The herdr pane a process runs in, from its environment or else the
    nearest of its parents': "w9:p7", or ""."""
    for q in [pid] + up:
        try:
            with open("/proc/%d/environ" % q, "rb") as f:
                env = f.read().split(b"\0")
        except OSError:
            continue
        for var in env:
            if var.startswith(b"HERDR_PANE_ID="):
                return var[14:].decode(errors="replace")
    return ""


# Tools that read one input from start to end, so how far into it they are
# says how far along the task is.
COPIERS = {"dd", "zstd", "xz", "ffmpeg"}
MIN_INPUT = 1 << 20


def reads_through(argv):
    tool, args = program(argv)
    if tool in COPIERS:
        return True
    if tool == "tar":
        first = args[0] if args else ""
        return any(a in ("-x", "--extract", "--get") for a in args) or bool(re.match(r"^-?[A-Za-z]*x", first))
    if tool == "7z":
        words = positional(args)
        return bool(words) and words[0] in ("x", "e")
    return False


def input_of(tree):
    """The biggest regular file a process of the tree reads (opened
    read-only): (path, position, size), or None."""
    best = None
    for q in tree:
        try:
            fds = os.listdir("/proc/%d/fd" % q)
        except OSError:
            continue
        for fd in fds:
            try:
                target = os.readlink("/proc/%d/fd/%s" % (q, fd))
                if not target.startswith("/") or target.startswith(("/dev/", "/proc/", "/sys/")):
                    continue
                st = os.stat("/proc/%d/fd/%s" % (q, fd))
                if not stat.S_ISREG(st.st_mode) or st.st_size < MIN_INPUT or (best and st.st_size <= best[2]):
                    continue
                pos = flags = None
                with open("/proc/%d/fdinfo/%s" % (q, fd)) as f:
                    for line in f:
                        if line.startswith("pos:"):
                            pos = int(line.split()[1])
                        elif line.startswith("flags:"):
                            flags = int(line.split()[1], 8)
                if pos is None or flags is None or flags & 3 != 0:
                    continue
                best = (target, pos, st.st_size)
            except (OSError, ValueError):
                continue
    return best


def cwd_of(pid):
    try:
        return os.readlink("/proc/%d/cwd" % pid)
    except OSError:
        return ""


def read_commands(now):
    """The exit statuses the shell hook wrote in the last half hour; the file
    is cut back to those now and then."""
    try:
        with open(COMMANDS) as f:
            lines = f.readlines()
    except OSError:
        return []
    out = []
    for line in lines:
        try:
            r = json.loads(line)
        except ValueError:
            continue
        if now - r.get("end", 0) < HISTORY_S:
            out.append(r)
    if len(lines) > 200:
        tmp = COMMANDS + ".tmp"
        try:
            with open(tmp, "w") as f:
                f.writelines(json.dumps(r) + "\n" for r in out)
            os.replace(tmp, COMMANDS)
        except OSError:
            pass
    return out


def status_of(task, commands):
    for r in commands:
        if r.get("shell") in task["shells"] and abs(r.get("end", 0) - task["ended"]) <= TICK * 3 and r.get("start", 0) <= task["started"] + 3:
            code = r.get("status", 0)
            return "success" if code == 0 else "cancelled" if code in (130, 143) else "failure"
    return None


def load_history():
    """The tasks that ended, from the last time."""
    try:
        with open(HISTORY) as f:
            saved = json.load(f)
    except (OSError, ValueError):
        return {}
    out = {}
    for t in saved if isinstance(saved, list) else []:
        if isinstance(t, dict) and t.get("id") and t.get("ended"):
            t = {k: t.get(k, "") for k in KEPT}
            t["shells"] = []
            out[t["id"]] = t
    return out


def save_history(ended):
    try:
        os.makedirs(STATE, exist_ok=True)
        tmp = HISTORY + ".tmp"
        with open(tmp, "w") as f:
            json.dump([{k: t[k] for k in KEPT} for t in ended], f)
        os.replace(tmp, HISTORY)
    except OSError:
        pass


def load_durations():
    try:
        with open(DURATIONS) as f:
            saved = json.load(f)
    except (OSError, ValueError):
        return {}
    return {k: v for k, v in saved.items() if isinstance(v, dict) and isinstance(v.get("runs"), list)} if isinstance(saved, dict) else {}


def save_durations(durations):
    if len(durations) > DURATIONS_MAX:
        for k in sorted(durations, key=lambda k: durations[k].get("at", 0))[:len(durations) - DURATIONS_MAX]:
            del durations[k]
    try:
        os.makedirs(STATE, exist_ok=True)
        tmp = DURATIONS + ".tmp"
        with open(tmp, "w") as f:
            json.dump(durations, f)
        os.replace(tmp, DURATIONS)
    except OSError:
        pass


def expected_of(durations, key):
    runs = sorted(durations.get(key, {}).get("runs", [])[-3:])
    if len(runs) == 2:
        return round(sum(runs) / 2)
    return runs[len(runs) // 2] if runs else 0


def task_folder(cwd):
    return base(cwd) if cwd not in ("", "/", os.path.expanduser("~")) else ""


def main():
    extra = set(sys.argv[1:])
    tasks = load_history()   # id -> task
    for t in tasks.values():
        t["timed"] = True
    durations = load_durations()
    saved = None
    last = {}   # pid -> the process at the last look
    last_time = time.time()

    while True:
        now = time.time()
        dt = max(0.5, now - last_time)
        last_time = now
        procs = scan()

        labels = {}
        for pid, p in procs.items():
            label = match(p["argv"], extra)
            if label:
                labels[pid] = label

        # A process that wasn't there at the last look started since; on
        # the first look there's nothing to compare with.
        def before(pid, p):
            old = last.get(pid)
            if old and old["start"] == p["start"]:
                return old
            return {"own": 0, "total": 0} if last else p

        busy = {pid for pid, p in procs.items() if p["own"] > before(pid, p)["own"]}
        cpu_of = {pid: max(0, p["total"] - before(pid, p)["total"]) for pid, p in procs.items()}
        # Processes that ended since: the nearest one above them that's
        # still there now holds all of their time, some of which was counted
        # at the last look. (A compiler and the gcc that ran it often end
        # together, and make gets both.)
        gone = {pid for pid, old in last.items() if pid not in procs or procs[pid]["start"] != old["start"]}
        ended_of = {}
        for pid in gone:
            up = last[pid]["ppid"]
            while up in gone:
                up = last[up]["ppid"]
            ended_of[up] = ended_of.get(up, 0) + last[pid]["total"]
        last = procs

        # Children, for each task's jobs and CPU.
        children = {}
        for pid, p in procs.items():
            children.setdefault(p["ppid"], []).append(pid)

        seen = set()
        for pid, label in labels.items():
            up = ancestors(pid, procs)
            if any(a in labels for a in up):
                continue
            p = procs[pid]
            tid = "%d-%d" % (pid, int(p["start"]))
            seen.add(tid)
            tree, stack = [], [pid]
            while stack:
                q = stack.pop()
                tree.append(q)
                stack.extend(children.get(q, []))
            task = tasks.get(tid)
            if not task:
                folder = task_folder(cwd_of(pid))
                # An agent that started it, if one did.
                names = [base((procs[a]["argv"] or [""])[0]) for a in up if a in procs]
                by = next((n for n in names if n in AGENTS), "")
                task = tasks[tid] = {
                    "id": tid, "label": label, "folder": folder,
                    "by": by, "started": p["start"], "shells": [pid] + up, "ended": 0, "state": "running",
                    "expected": expected_of(durations, label + "\n" + folder), "load": [], "step": "", "step_at": 0,
                    "pane": pane_of(pid, up), "copy": reads_through(p["argv"]), "progress": -1, "rate": 0, "input": None,
                }
            ticks = max(0, sum(cpu_of.get(q, 0) - ended_of.get(q, 0) for q in tree))
            task["cpu"] = round(ticks / CLK / dt * 100)
            task["jobs"] = sum(1 for q in tree[1:] if q in busy)
            task["load"] = (task["load"] + [min(100, round(task["cpu"] / NCPU))])[-LOAD_KEEP:]
            if task["copy"]:
                read = input_of(tree)
                before = task["input"]
                if read:
                    task["progress"] = round(min(1.0, read[1] / read[2]), 4)
                    task["rate"] = round(max(0, read[1] - before[1]) / dt) if before and before[0] == read[0] else task["rate"]
                else:
                    task["progress"], task["rate"] = -1, 0
                task["input"] = read
            # A step stays a moment after its process ends, so the row
            # doesn't blink between two compiles.
            step = step_of(tree, procs, busy, labels)
            if step:
                task["step"], task["step_at"] = step, now
            elif now - task["step_at"] > TICK * 2.5:
                task["step"] = ""

        commands = None
        for tid, task in list(tasks.items()):
            if tid in seen:
                continue
            if task["state"] == "running":
                if now - task["started"] < MIN_AGE + TICK:
                    del tasks[tid]
                    continue
                task["ended"] = now
                task["state"] = "done"
                task["cpu"] = task["jobs"] = 0
            if task["state"] == "done" and now - task["ended"] < STATUS_WAIT_S:
                if commands is None:
                    commands = read_commands(now)
                task["state"] = status_of(task, commands) or "done"

        # How long a task took, once it's known it didn't fail: what the
        # next run of it is measured against.
        timed = False
        for task in tasks.values():
            if task["ended"] and not task.get("timed") and (task["state"] == "success" or task["state"] == "done" and now - task["ended"] >= STATUS_WAIT_S):
                task["timed"] = True
                key = task["label"] + "\n" + task["folder"]
                runs = durations.get(key, {}).get("runs", []) + [round(task["ended"] - task["started"])]
                durations[key] = {"runs": runs[-DURATIONS_KEEP:], "at": round(now)}
                timed = True
            elif task["ended"] and task["state"] in ("failure", "cancelled"):
                task["timed"] = True
        if timed:
            save_durations(durations)

        running = sorted((t for t in tasks.values() if t["state"] == "running" and now - t["started"] >= MIN_AGE), key=lambda t: t["started"])
        ended = sorted((t for t in tasks.values() if t["ended"]), key=lambda t: -t["ended"])
        for t in ended[HISTORY_MAX:]:
            del tasks[t["id"]]
        ended = ended[:HISTORY_MAX]
        key = [(t["id"], t["state"]) for t in ended]
        if key != saved:
            save_history(ended)
            saved = key
        out = []
        for t in running + ended:
            out.append({
                "id": t["id"], "label": t["label"], "folder": t["folder"], "by": t["by"], "state": t["state"],
                "elapsed": round((t["ended"] or now) - t["started"]),
                "ago": round(now - t["ended"]) if t["ended"] else 0,
                "cpu": t.get("cpu", 0), "jobs": t.get("jobs", 0),
                "step": t.get("step", "") if not t["ended"] else "",
                "expected": t.get("expected", 0) if not t["ended"] else 0,
                "load": t.get("load", []) if not t["ended"] else [],
                "pane": t.get("pane", ""),
                "progress": t.get("progress", -1) if not t["ended"] else -1,
                "rate": t.get("rate", 0) if not t["ended"] else 0,
            })
        try:
            sys.stdout.write(json.dumps({"tasks": out}) + "\n")
            sys.stdout.flush()
        except BrokenPipeError:
            return 0

        readable, _, _ = select.select([sys.stdin], [], [], TICK)
        if readable and not sys.stdin.readline():
            return 0


if __name__ == "__main__":
    sys.exit(main())
